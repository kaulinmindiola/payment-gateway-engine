# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Plantilla de configuración local. Copiar a `.env`  y
# reemplazar los valores.
#
# Alcance actual: docker-compose.dev.yml (Postgres + Redis, Fase 1) y el
# datasource de application.yml. Se amplía en fases posteriores — ver
# IMPLEMENTATION_PLAN.md, Sección 17 ("Documentación a actualizar"):
#   Fase 7  -> parámetros adicionales de Redis / idempotencia (TTL)
#   Fase 8  -> configuración de authorization-provider (WireMock)
#   Fase 15 -> topología Docker Compose completa (4 servicios)
# =============================================================================

# --- PostgreSQL (CON-001) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_gateway
POSTGRES_USER=payment_gateway_app
POSTGRES_PASSWORD=changeme

# --- Redis (CON-001) ---
# Acelerador de idempotencia; nunca fuente de verdad (BR-005, NFR-AVAIL-01).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Aplicación ---
SERVER_PORT=8080
