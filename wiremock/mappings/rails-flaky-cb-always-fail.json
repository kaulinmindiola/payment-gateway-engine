{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/authorizations",
    "headers": {
      "X-Provider-Code": { "equalTo": "RAILS-flaky" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.targetExternalReference", "matches": ".*-CB-ALWAYS-FAIL$" } }
    ]
  },
  "response": {
    "status": 503,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "type": "https://authorization-provider/errors/unavailable",
      "title": "Service Temporarily Unavailable",
      "status": 503,
      "detail": "Downstream rail congestion (simulated)"
    }
  }
}